# My PG - Personal UPI Payment Gateway Configuration
# Self-hosted, zero-commission UPI payment gateway
# Deployed: Vercel serverless (no PC needed)

# Server Configuration
NODE_ENV=production
PORT_API=6100
PORT_CHECKOUT=7000
PORT_ADMIN=6001

# Database — SQLite for local dev, PostgreSQL for production (Vercel serverless)
DATABASE_PATH=./data/my_pg.sqlite
DATABASE_URL=postgresql://user:pass@localhost:5432/my_pg
USE_POSTGRES=false

# Security - IMPORTANT: Update these with strong random strings
JWT_SECRET=prabhgamestore2026jwt7k8m9n0p1q2r3s4t5u6v7w8x9y0z1a2b3c4d5e6f
WEBHOOK_SECRET=prabhgamestore2026webhook9k8m7n6p5q4r3s2t1u0v9w8x7y6z5a4b3c
ADMIN_TOKEN=prabhgamestore2026admin5k6m7n8p9q0r1s2t3u4v5w6x7y8z9a0b1c2d3e

# Merchant Configuration - YOUR REAL DETAILS
MERCHANT_NAME=Prabh Game Store
MERCHANT_PHONE=6280692792
MERCHANT_VPA=sehajsingh2611@okaxis
WEBHOOK_URL=https://prabh-game-store.vercel.app/api/v1/webhooks/merchant

# WhatsApp Authentication (Berry Protocol)
WHATSAPP_SENDER_NAME=Prabh Game Store
WHATSAPP_SESSION_PATH=./data/whatsapp_session
WHATSAPP_ENABLED=true

# Google Observer (OAuth2 for Gmail)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://prabh-game-store.vercel.app/api/v1/auth/google/callback
GMAIL_ENABLED=false

# Android Observer (HMAC)
ANDROID_OBSERVER_SECRET=prabhgamestore2026android3k4m5n6p7q8r9s0t1u2v3w4x5y6z7a8b

# Payment Timing (milliseconds)
PAYMENT_ACTIVE_WINDOW_MS=300000
PAYMENT_PROCESSING_WINDOW_MS=30000

# Webhook Configuration
WEBHOOK_MAX_RETRIES=5
WEBHOOK_TIMEOUT_MS=10000

# Frontend URLs (for CORS + QR generation) - Update after Vercel deployment
CHECKOUT_PUBLIC_URL=https://prabh-game-store.vercel.app
ADMIN_PUBLIC_URL=https://prabh-game-store.vercel.app/admin
API_PUBLIC_URL=https://prabh-game-store.vercel.app/api

# Branding (for white-label checkout)
DEFAULT_APP_NAME=Prabh Game Store
DEFAULT_PRIMARY_COLOR=#10b981
DEFAULT_SUPPORT_EMAIL=support@prabhgamestore.com
DEFAULT_SUPPORT_PHONE=6280692792
DEFAULT_LOGO_URL=https://prabhgamestore.com/logo.png
DEFAULT_HIDE_POWERED_BY=false
